# Environment & API Keys
.env
*.env
credentials.json
token.json
client_secret*.json

# Runtime Vector Database
*.sqlite
*.sqlite3
*.db
rag_vault.sqlite
memory/rag_vault.sqlite

# Generated Applications & Resumes
applications/

# Python cache & temp
__pycache__/
*.pyc
*.pyo
*.pyd

# Temp and logs
*.log
*.temp.html
test_render.*

# Large model weights (keep out of git; use LFS or external storage)
rvc_models/

# Ciel speech output (written at run time; pruned by ciel_server)
audio_cache/

# Per-bot heartbeat files (written at run time by health_recorder)
memory/health/
# Single-instance lock and PID of the running bots (instance_lock.py, 6B)
memory/lsfm-bots.lock
memory/lsfm-bots.pid
# Written by stop_squad.bat: scheduled starts stay away until a start by hand (ADR-001 R-1)
memory/bots.stopped
# Once-a-day post state (daily_once.claim writes the date, via a .tmp file); a missing file
# means "not posted yet", so a fresh clone needs none of them
memory/last_*_date.txt
memory/last_*_date.txt.tmp
# Yunjin's generated portfolio audits (yunjin_engine.AUDITS_DIR), like applications/
portfolio_audits/
