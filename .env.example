# ==============================================================================
# LSFM AI HQ — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCORD SQUAD BOT TOKENS
# Obtain bot tokens from https://discord.com/developers/applications/
# Enable 'Message Content Intent' and 'Server Members Intent' for each bot!
# ------------------------------------------------------------------------------

# 🌸 Sakura — Chief of Staff & Central Orchestrator
SAKURA_BOT_TOKEN=your_sakura_bot_token_here

# ⭐ Chaewon — Career & Job Application Copilot
CHAEWON_BOT_TOKEN=your_chaewon_bot_token_here

# 🎨 Yunjin — Document Architect & Portfolio Agent
YUNJIN_BOT_TOKEN=your_yunjin_bot_token_here

# 💻 Kazuha — Knowledge Officer & Vector RAG Agent
KAZUHA_BOT_TOKEN=your_kazuha_bot_token_here

# 🛡️ Eunchae — System Guardian & Gmail Triage Agent
EUNCHAE_BOT_TOKEN=your_eunchae_bot_token_here

# (Optional) Primary Discord Server ID for REST directory setup scripts
DISCORD_GUILD_ID=your_discord_guild_id_here


# ------------------------------------------------------------------------------
# 2. AI / LLM INFERENCE CREDENTIALS
# ------------------------------------------------------------------------------

# Google Gemini API Key (for 3072-dim embeddings & fallback inference)
# Obtain free from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (primary cloud inference)
# Obtain free from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# (Optional) OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here


# ------------------------------------------------------------------------------
# 3. LOCAL INFERENCE (optional Ollama, used when the brain mode is local/auto)
# The local model and the mode live in memory/brain_mode.json (switch with !mode).
# A "localhost" host is pinned to 127.0.0.1 (Ollama listens on IPv4 only).
# ------------------------------------------------------------------------------
LOCAL_LLM_URL=http://127.0.0.1:11434/v1

# ------------------------------------------------------------------------------
# 4. CANDIDATE PROFILE & OBSIDIAN
# ------------------------------------------------------------------------------
# Candidate details used for resume compilation and application tailoring.
OWNER_NAME=Your Name
OWNER_EMAIL=you@example.com
OWNER_LOCATION=City, State / Country
PORTFOLIO_URL=https://example.com
PORTFOLIO_DISPLAY=example.com

# Obsidian vault folder (default: an "Obsidian" folder next to Projects/).
OBSIDIAN_VAULT_PATH=/path/to/your/Obsidian/vault
# Obsidian Local REST API plugin key (optional; the filesystem is the fallback).
OBSIDIAN_API_KEY=your_obsidian_rest_api_key_here
